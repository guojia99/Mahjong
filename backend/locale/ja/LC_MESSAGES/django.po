msgid "用户名或密码错误"
msgstr "ユーザー名またはパスワードが間違っています"

msgid "仅管理员可登录"
msgstr "管理者のみログイン可能です"

msgid "已登出"
msgstr "ログアウトしました"

msgid "该UID已绑定其他雀士"
msgstr "このUIDは既に他の雀士に紐付けされています"

msgid "无效的雀魂 UID"
msgstr "無効な雀魂 UID です"

msgid "该雀魂 UID 已绑定其他雀士，无法随对局导入写入"
msgstr "この雀魂 UID は既に他の雀士に紐付けされているため、対局インポート時に自動作成できません"

msgid "雀魂账号不存在"
msgstr "雀魂アカウントが存在しません"

msgid "该账号已绑定其他雀士"
msgstr "このアカウントは既に他の雀士に紐付けされています"

msgid "需要 ids 数组"
msgstr "ids 配列が必要です"

msgid "房间已关闭"
msgstr "ルームは既に閉じられています"

msgid "该雀士已在房间中"
msgstr "この雀士は既にルームにいます"

msgid "房间已关闭，无法添加玩家"
msgstr "ルームは既に閉じられているため、雀士を追加できません"

msgid "该雀士不在房间中"
msgstr "この雀士はルームにいません"

msgid "房间已关闭，无法创建对局"
msgstr "ルームは既に閉じられているため、対局を作成できません"

msgid "雀士不存在: %(player_id)s"
msgstr "雀士が存在しません: %(player_id)s"

msgid "对局已录分，无法更换选手"
msgstr "対局は既に採点済みのため、雀士を変更できません"

msgid "4人对局分数总和必须为1000，当前为%(total)s"
msgstr "4人対局のスコア合計は1000である必要があります。現在: %(total)s"

msgid "3人对局分数总和必须为1050，当前为%(total)s"
msgstr "3人対局のスコア合計は1050である必要があります。現在: %(total)s"

msgid "选手不在对局中: %(player_id)s"
msgstr "雀士はこの対局にいません: %(player_id)s"

msgid "对局未录分，无法添加牌谱"
msgstr "対局は未採点のため、牌譜を追加できません"

msgid "无效的役种: %(name)s"
msgstr "無効な役: %(name)s"

msgid "该房间存在对局记录，无法删除"
msgstr "このルームには対局記録が存在するため、削除できません"

msgid "房间已关闭，无法新增对局"
msgstr "ルームは既に閉じられているため、対局を追加できません"

msgid "对局已录分，无法调整席次"
msgstr "対局は既に採点済みのため、席順を変更できません"

msgid "请提供牌谱链接（需包含 https:// 或 http://）"
msgstr "牌譜リンクを指定してください（https:// または http:// を含む必要があります）"

msgid "解析牌谱失败: %(e)s"
msgstr "牌譜の解析に失敗しました: %(e)s"

msgid "未找到牌谱数据，请检查链接是否有效"
msgstr "牌譜データが見つかりませんでした。リンクが有効か確認してください"

msgid "请提供 urls 数组"
msgstr "urls 配列が必要です"

msgid "空行"
msgstr "空行"

msgid "未识别到有效的 http(s) 牌谱链接"
msgstr "有効な http(s) 牌譜リンクが認識されませんでした"

msgid "请选择「线上场」房间"
msgstr "「オンライン卓」ルームを選択してください"

msgid "房间已关闭，无法导入"
msgstr "ルームは既に閉じられているため、インポートできません"

msgid "该牌谱链接已在系统中存在对局。若仍要再导入一条记录，请在导入页勾选「仍导入本条」后重试。"
msgstr "この牌譜リンクの対局は既にシステムに存在します。それでももう一件インポートする場合は、インポートページで「強制インポート」にチェックを入れて再試行してください。"

msgid "请提供account_id和player_id"
msgstr "account_idとplayer_idを指定してください"

msgid "雀士不存在"
msgstr "雀士が存在しません"

msgid "仅线上对局可重新获取"
msgstr "オンライン対局のみ再取得可能です"

msgid "该对局无牌谱链接，无法重新获取"
msgstr "この対局には牌譜リンクがないため、再取得できません"

msgid "牌谱链接无效"
msgstr "牌譜リンクが無効です"

msgid "牌谱获取失败: %(e)s"
msgstr "牌譜の取得に失敗しました: %(e)s"

msgid "未获取到牌谱数据"
msgstr "牌譜データを取得できませんでした"

msgid "存在重复的选手"
msgstr "重複する雀士がいます"

msgid "必须指定一名东起选手"
msgstr "東起ちの雀士を1名指定してください"

msgid "至少需要选择一个役种"
msgstr "最低1つの役を選択してください"

msgid "未配置 MAJSOUL_NODE_SCRIPT_DIR"
msgstr "MAJSOUL_NODE_SCRIPT_DIR が設定されていません"

msgid "未配置雀魂账号密码（MAJSOUL_ACCOUNT / MAJSOUL_PASSWORD）"
msgstr "雀魂アカウントの認証情報が設定されていません（MAJSOUL_ACCOUNT / MAJSOUL_PASSWORD）"

msgid "牌谱获取失败: %(stderr)s"
msgstr "牌譜の取得に失敗しました: %(stderr)s"

msgid "Node paipu.js 无输出"
msgstr "Node paipu.js の出力がありません"

msgid "牌谱获取返回了无效数据"
msgstr "牌譜取得が無効なデータを返しました"

msgid "牌谱获取失败: %(error)s"
msgstr "牌譜の取得に失敗しました: %(error)s"

msgid "空链接或未识别到有效的 http(s) 牌谱链接"
msgstr "リンクが空か、有効な http(s) 牌譜リンクが認識されませんでした"

msgid "牌谱解析失败: %(e)s"
msgstr "牌譜の解析に失敗しました: %(e)s"

msgid "未返回牌谱数据，请检查链接是否有效"
msgstr "牌譜データが返されませんでした。リンクが有効か確認してください"

msgid "未解析到有效玩家行"
msgstr "有効な雀士行が解析されませんでした"

msgid "排位分重新结算完成"
msgstr "レート再計算が完了しました"

msgid "重算失败: %(e)s"
msgstr "再計算に失敗しました: %(e)s"

msgid "仅四麻半庄计算排位分"
msgstr "レート計算は四麻半荘のみ対象です"
